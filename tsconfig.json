{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Compiled from the submodule, not installed, so each specifier maps to the built output it
    // resolves to at runtime. api is TYPE-ONLY here: nothing imports its runtime, so none of it
    // reaches the deployed bundle.
    "paths": {
      "@intisy-ai/core": ["./core/dist/index.d.ts"],
      "@intisy-ai/api": ["./core/api/generated/api.keys.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
